# Postgres
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=travel_pass
POSTGRES_DB=travel_db
POSTGRES_PORT=5432
# Host is "postgres" (the compose service name) when running via docker compose.
# Use "localhost" instead if running the backend directly on your machine.
DATABASE_URL=postgresql://travel_user:travel_pass@postgres:5432/travel_db

# Redis
REDIS_PORT=6379
# Host is "redis" (the compose service name) when running via docker compose.
# Use "localhost" instead if running the backend directly on your machine.
REDIS_URL=redis://redis:6379
REDIS_CACHE_TTL_SECONDS=900

# Backend
PORT=3001

# Frontend
FRONTEND_PORT=3000
# Baked into the frontend build (Next.js public env vars are inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:3001
